# MONOLITH server
MONOLITH_HOST=0.0.0.0
MONOLITH_PORT=5000
MONOLITH_DEBUG=false
# Private runtime directory; keep its contents out of the source repository
MONOLITH_DATA_DIR=

# HomeKit: private pairing PIN; required before starting the bridge
HOMEKIT_PIN=

# Web Push (optional contact URI for VAPID)
MONOLITH_VAPID_SUBJECT=https://example.com

# Kamera-Livebild (RTSP bleibt ausschließlich auf dem Server)
CAMERA_NAME=Kamera
CAMERA_RTSP_URL=
CAMERA_RTSP_USERNAME=
CAMERA_RTSP_PASSWORD=
CAMERA_PREVIEW_FPS=10
CAMERA_PREVIEW_WIDTH=1280
CAMERA_PREVIEW_QUALITY=5
CAMERA_MAX_VIEWERS=2

# FRITZ!Box / PC status
FRITZBOX_ADDRESS=
FRITZBOX_USER=
FRITZBOX_PASSWORD=
PC_MAC=
PC_IP=
# Optional: weitere wichtige Geräte für Offline-Warnungen (kommagetrennt)
NETWORK_IMPORTANT_MACS=
# Optional: Abfrageintervall für Verlauf und Netzwerkereignisse
NETWORK_REFRESH_INTERVAL_SECONDS=15
PC_AGENT_PORT=8765
PC_AGENT_TOKEN=
PC_AGENT_TIMEOUT_SECONDS=2
PC_CHECK_INTERVAL_SECONDS=5

# Presence
PRESENCE_AWAY_AFTER_SECONDS=1200
PRESENCE_PROBE_TIMEOUT_SECONDS=2

# LG TV
LG_TV_IP=
LG_TV_MAC=

# HomePod
HOMEPOD_IP=
HOMEPOD_IDENTIFIER=
HOMEPOD_NAME=
HOMEPOD_SCAN_INTERVAL_SECONDS=10
HOMEPOD_SCAN_TIMEOUT_SECONDS=5

# Apple TV
APPLE_TV_IP=
APPLE_TV_IDENTIFIER=
APPLE_TV_NAME=
APPLE_TV_SCAN_INTERVAL_SECONDS=2
APPLE_TV_SCAN_TIMEOUT_SECONDS=5

# Matterbridge
MATTERBRIDGE_WS_URL=ws://127.0.0.1:8283/devices

# WeWash
WEWASH_USERNAME=
WEWASH_PASSWORD=
WEWASH_LAUNDRY_ROOM_ID=

# Picnic
PICNIC_USERNAME=
PICNIC_PASSWORD=
PICNIC_COUNTRY_CODE=DE

# Router-based console status (optional)
NINTENDO_SWITCH_MAC=
NINTENDO_SWITCH_IP=
# Optional room override; blank uses the example device assignment
NINTENDO_SWITCH_ROOM=
ROBOVAC_SERIAL=
DIAGNOSTIC_DEVICE_MAC=

# Generic dashboard people. Configure only devices belonging to each person.
PRESENCE_PERSON_1_NAME=Person 1
PRESENCE_PERSON_1_DEVICE_1_IP=
PRESENCE_PERSON_1_DEVICE_1_MAC=
PRESENCE_PERSON_2_NAME=Person 2
PRESENCE_PERSON_2_DEVICE_1_IP=
PRESENCE_PERSON_2_DEVICE_1_MAC=
PRESENCE_PERSON_2_DEVICE_2_IP=
PRESENCE_PERSON_2_DEVICE_2_MAC=

SHIP24_API_KEY=
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
